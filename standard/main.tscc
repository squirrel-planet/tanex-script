os":[348,31]}},"pos":[348,18]}},{"unary":{"operator":"return","operand":{"binary":{"operator":"&&","left":{"binary":{"operator":"==","left":{"name":{"value":"front_value","pos":[349,12]}},"right":{"integer":{"value":"0","pos":[349,27]}},"pos":[349,24]}},"right":{"binary":{"operator":"==","left":{"name":{"value":"back_value","pos":[349,32]}},"right":{"integer":{"value":"0","pos":[349,46]}},"pos":[349,43]}},"pos":[349,29]}},"pos":[349,5]}}],"pos":[346,27]}},"pos":[346,24]}},"pos":[346,13]}},{"assignment":{"operator":"=","left":{"unary":{"operator":"***","operand":{"name":{"value":"public","pos":[354,5]}},"pos":[354,1]}},"right":{"list":{"items":[{"string":{"value":"\"output\"","pos":[355,5]}},{"string":{"value":"\"print_line\"","pos":[356,5]}},{"string":{"value":"\"for\"","pos":[357,5]}},{"string":{"value":"\"while\"","pos":[358,5]}},{"string":{"value":"\"if\"","pos":[359,5]}},{"string":{"value":"\"cycle\"","pos":[360,5]}},{"string":{"value":"\"try\"","pos":[361,5]}},{"string":{"value":"\"length_of\"","pos":[362,5]}},{"string":{"value":"\"reverse_string\"","pos":[363,5]}},{"string":{"value":"\"reverse_list\"","pos":[364,5]}},{"string":{"value":"\"clone_list\"","pos":[365,5]}},{"string":{"value":"\"range\"","pos":[366,5]}},{"string":{"value":"\"for_each\"","pos":[367,5]}},{"string":{"value":"\"filter\"","pos":[368,5]}},{"string":{"value":"\"any\"","pos":[369,5]}},{"string":{"value":"\"all\"","pos":[370,5]}},{"string":{"value":"\"find\"","pos":[371,5]}},{"string":{"value":"\"concatenate\"","pos":[372,5]}},{"string":{"value":"\"node_set\"","pos":[373,5]}},{"string":{"value":"\"is_nan\"","pos":[374,5]}},{"string":{"value":"\"is_infinity\"","pos":[375,5]}},{"string":{"value":"\"is_none\"","pos":[376,5]}},{"string":{"value":"\"is_zero\"","pos":[377,5]}},{"string":{"value":"\"match\"","pos":[378,5]}}],"pos":[354,14]}},"pos":[354,12]}}],"annotations":{"end_line":"换行","output":"输出一个可转字符串的值。\ninteger_is_unicode 为 false 时，整数按十进制逐位输出（每位 + 48）。\noutput(value: type_type, integer_is_unicode: boolean)","for":"遍历一个可遍历值，每遍历一次执行一次操作。\nfor(var: address, for_list: list, for_code: code)\n示例：\n-> \"standard\";\nfor(*str, [\n    \"Hello World\", \"Hello Tanex Script\",\n    \"Bye World\", \"Bye Tanex Script\"], {\n    output(str);\n});","match":"对单个值做条件匹配：把 value 传给第二参字典中每个键（键为函数/code，条件），\n条件返回真时调用对应值（函数/code，结果）并把其返回值作为 match 返回值；\n全部不命中时调用第三参兜底函数/code；兜底缺省时返回 none。\n注意：遍历顺序与字典哈希桶序一致，多个条件同时为真时命中顺序不确定，条件应互斥。\nmatch(value, match_dict: dictionary, else: code/function_type)\n示例：\n-> \"standard\";\na = 1;\nb = 2;\nmatch(a, {\n    [*x] => { return x > b; }: { return \"a>b\"; },\n    [*x] => { return x < b; }: { return \"a<b\"; }\n}, { return \"a==b\"; });","while":"当条件为真时循环执行代码块","if":"条件为真执行 if_code，否则执行 else_code","cycle":"循环执行代码块 cycle_number 次","try":"尝试执行 try_code；出错时执行 err_code，成功时执行 else_code","function":"返回一个函数。\n示例：\nfunction([*a, *b, *c], {\n    $ a + b + c;\n});","type":"返回一个类型。","length_of":"返回字符串或列表的长度","reverse_string":"反转字符串","reverse_list":"反转列表","clone_list":"复制一个新列表","range":"生成整数序列列表；range(end) 或 range(start, end, step)，支持升序与降序","for_each":"对列表中每个元素调用一次函数","filter":"返回函数判定为真的元素组成的新列表","any":"存在任一元素使函数返回真则返回 true","all":"所有元素使函数返回真才返回 true","find":"返回第一个使函数返回真的元素，无则返回 none","concatenate":"拼接两个值（字符串或列表）","node_set":"设置列表中指定下标位置的值","print_line":"输出一个可转字符串的值并换行；integer_is_unicode 为 false 时整数按十进制输出","is_nan":"判断是否为 NaN","is_infinity":"判断是否为无穷大","is_none":"判断是否为 none","is_zero":"判断整数或数字是否为零"},"annotation":"Tanex Script 标准库"}