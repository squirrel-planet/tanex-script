  "annotations": {
    "end_line": "换行",
    "output": "输出一个可转字符串的值。\ninteger_is_unicode 为 false 时，整数按十进制逐位输出（每位 + 48）。\noutput(value: type_type, integer_is_unicode: boolean)",
    "for": "遍历一个可遍历值，每遍历一次执行一次操作。\nfor(var: address, for_list: list, for_code: code)\n示例：\n-> \"standard\";\nfor(*str, [\n    \"Hello World\", \"Hello Tanex Script\",\n    \"Bye World\", \"Bye Tanex Script\"], {\n    output(str);\n});",
    "while": "当条件为真时循环执行代码块",
    "if": "条件为真执行 if_code，否则执行 else_code",
    "cycle": "循环执行代码块 cycle_number 次",
    "try": "尝试执行 try_code；出错时执行 err_code，成功时执行 else_code",
    "function": "返回一个函数。\n示例：\nfunction([*a, *b, *c], {\n    $ a + b + c;\n});",
    "type": "返回一个类型。",
    "length_of": "返回字符串或列表的长度",
    "reverse_string": "反转字符串",
    "reverse_list": "反转列表",
    "clone_list": "复制一个新列表",
    "range": "生成整数序列列表；range(end) 或 range(start, end, step)，支持升序与降序",
    "for_each": "对列表中每个元素调用一次函数",
    "filter": "返回函数判定为真的元素组成的新列表",
    "any": "存在任一元素使函数返回真则返回 true",
    "all": "所有元素使函数返回真才返回 true",
    "find": "返回第一个使函数返回真的元素，无则返回 none",
    "concatenate": "拼接两个值（字符串或列表）",
    "node_set": "设置列表中指定下标位置的值",
    "print_line": "输出一个可转字符串的值并换行；integer_is_unicode 为 false 时整数按十进制输出",
    "is_nan": "判断是否为 NaN",
    "is_infinity": "判断是否为无穷大",
    "is_none": "判断是否为 none",
    "is_zero": "判断整数或数字是否为零"
  },
